web: sh -c 'export INDFLOW_DB_PATH="${INDFLOW_DB_PATH:-/data/indflow.db}"; if [ "${INDFLOW_MIGRATION_APPLY_ON_START:-0}" = "1" ]; then python tools/instalar_snapshot_migracao.py --snapshot "${INDFLOW_MIGRATION_SNAPSHOT_PATH:-/data/migracao/indflow_snapshot.db}" --confirm; fi; exec waitress-serve --host=0.0.0.0 --port="$PORT" server:app'
